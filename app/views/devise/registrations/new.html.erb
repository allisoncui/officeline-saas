<div style="max-width: 400px; margin: 40px auto; padding: 24px; background: white; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
  <h2 style="margin-top: 0; color: #0f172a;">
    Sign Up as <%= params[:role]&.capitalize || 'Student' %>
  </h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div style="margin-bottom: 16px;">
      <%= f.label :uni, "UNI", style: "display: block; margin-bottom: 4px; font-weight: 500; color: #0f172a;" %>
      <%= f.text_field :uni, autofocus: true, autocomplete: "username",
          style: "width: 100%; padding: 8px 12px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 1rem;" %>
      <small style="color: #64748b; font-size: 0.85rem;">
        <% existing_account = User.find_by(uni: f.object.uni, role: params[:role]) if f.object.uni.present? %>
        <% if existing_account %>
          <span style="color: #dc2626;">This UNI already has a <%= params[:role] %> account.</span>
        <% end %>
      </small>
    </div>

    <%= f.hidden_field :role, value: params[:role] || 'student' %>

    <% if params[:role] == 'ta' %>
      <div style="margin-bottom: 16px;">
        <%= f.label :course_name, "Course Name", style: "display: block; margin-bottom: 4px; font-weight: 500; color: #0f172a;" %>
        <%= f.text_field :course_name,
            placeholder: "e.g., Engineering SaaS",
            style: "width: 100%; padding: 8px 12px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 1rem;" %>
      </div>
    <% end %>

    <div style="margin-bottom: 16px;">
      <%= f.label :password, style: "display: block; margin-bottom: 4px; font-weight: 500; color: #0f172a;" %>
      <% if @minimum_password_length %>
        <span style="color: #64748b; font-size: 0.85rem;">(<%= @minimum_password_length %> characters minimum)</span>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password",
          style: "width: 100%; padding: 8px 12px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 1rem;" %>
    </div>

    <div style="margin-bottom: 20px;">
      <%= f.label :password_confirmation, style: "display: block; margin-bottom: 4px; font-weight: 500; color: #0f172a;" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password",
          style: "width: 100%; padding: 8px 12px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 1rem;" %>
    </div>

    <%= f.submit "Sign Up", class: "ol-btn", style: "width: 100%; padding: 12px; font-size: 1rem; background: #16a34a; color: white; border: none; border-radius: 6px; cursor: pointer;" %>
  <% end %>

  <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid #e5e7eb; text-align: center;">
    <%= link_to "Already have an account? Sign in", new_user_session_path, style: "color: #2563eb; text-decoration: none; font-weight: 500; display: block; margin-bottom: 8px;" %>
    <% if params[:role] == 'ta' %>
      <%= link_to "Sign up as Student instead", new_user_registration_path(role: 'student'), style: "color: #64748b; text-decoration: none; font-size: 0.9rem;" %>
    <% else %>
      <%= link_to "Sign up as TA instead", new_user_registration_path(role: 'ta'), style: "color: #64748b; text-decoration: none; font-size: 0.9rem;" %>
    <% end %>
  </div>
</div>