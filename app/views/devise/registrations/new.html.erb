<h2>Sign up</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <%= f.label :uni, "University ID (UNI)" %><br />
    <%= f.text_field :uni, autofocus: true, autocomplete: "uni" %>
  </div>

  <div class="field">
    <%= f.label :role, "Role" %><br />
    <%= f.select :role, options_for_select([['Student', 'student'], ['TA', 'ta']], f.object.role),
                 { prompt: 'Select your role' },
                 { id: 'user_role', onchange: 'toggleCourseNameField();' } %>
  </div>

  <div class="field" id="course_name_field" style="<%= 'display: none;' unless f.object.role == 'ta' %>">
    <%= f.label :course_name, "Course Name" %><br />
    <%= f.text_field :course_name, placeholder: "Enter your course name (e.g. Data Structures)" %>
  </div>

  <script>
    function toggleCourseNameField() {
      var roleSelect = document.getElementById('user_role');
      var courseNameField = document.getElementById('course_name_field');
      if (roleSelect.value === 'ta') {
        courseNameField.style.display = 'block';
      } else {
        courseNameField.style.display = 'none';
      }
    }
  </script>


  <div class="field">
    <%= f.label :password %>
    <% if @minimum_password_length %>
    <em>(<%= @minimum_password_length %> characters minimum)</em>
    <% end %><br />
    <%= f.password_field :password, autocomplete: "new-password" %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation %><br />
    <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
  </div>

  <div class="actions">
    <%= f.submit "Sign up" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
