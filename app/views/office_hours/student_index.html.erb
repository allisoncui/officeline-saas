<%= form_tag office_hours_path, method: :get, id: 'days_form', local: true, class: "ol-controls" do %>
  <div class="ol-row">
    <span class="ol-label">Include:</span>
    <% @all_days.each do |day| %>
      <label class="ol-check">
        <%= check_box_tag "days[#{day}]", "1", @days_to_show.include?(day), class: 'form-check-input' %>
        <span><%= day %></span>
      </label>
    <% end %>
  </div>

  <div class="ol-row">
    <label class="ol-label" for="sort_by">Sort by:</label>
    <%= select_tag :sort_by,
                   options_for_select([["Course", "course_name"],
                                       ["Instructor", "instructor"],
                                       ["Day & Time", "day"]], @sort_by),
                   id: "sort_by",
                   class: "ol-select" %>

    <%= submit_tag 'Refresh', id: 'days_submit', class: 'ol-btn' %>
    <%= link_to "Clear filters", office_hours_path, class: "ol-link" %>
  </div>

  <h1>Office Hours</h1>

  <% if @office_hours.present? %>
    <p id="results-summary" class="ol-muted">
      <%= pluralize(@office_hours.size, "result") %>
    </p>
  <% else %>
    <p id="results-empty" class="ol-muted">No office hours match your filters.</p>
  <% end %>

  <% current_view = params[:view] == "calendar" ? "calendar" : "list" %>
  <%= hidden_field_tag :view, current_view, id: "hidden_view" %>

  <div class="toggle-container" style="margin-bottom: 20px;">
    <input type="checkbox"
           id="calendar_toggle"
           <%= "checked" if current_view == "calendar" %>
           onchange="
             const hv = document.getElementById('hidden_view');
             hv.value = this.checked ? 'calendar' : 'list';
             this.form.submit();
           ">
    <label for="calendar_toggle" class="toggle-label">
      <span class="toggle-option list">List</span>
      <span class="toggle-option calendar">Calendar</span>
      <span class="toggle-slider"></span>
    </label>
  </div>
<% end %>

<% if params[:view] == "calendar" %>
  <%= render "calendar" %>
<% else %>
  <!-- LIST VIEW -->
  <div id="office_hours" class="ol-list">
    <% if @office_hours.present? %>
      <% @office_hours.each do |oh| %>
        <%= link_to office_hour_path(oh),
            style: "text-decoration: none; color: inherit; display: block;" do %>
          <div class="ol-card"
               style="
                 position: relative;
                 margin-top: 12px;
                 padding: 16px;
                 border-radius: 10px;
                 background: #f9fafb;
                 cursor: pointer;
                 transition: all 0.2s ease-in-out;
                 border: 1px solid #e5e7eb;
               "
               onmouseover="this.style.background='#e0ecff'; this.style.transform='scale(1.01)'; this.style.boxShadow='0 4px 10px rgba(0,0,0,0.08)';"
               onmouseout="this.style.background='#f9fafb'; this.style.transform='scale(1)'; this.style.boxShadow='none';">
            <p><strong>Course:</strong> <%= oh.course_name %></p>
            <p><strong>Instructor:</strong> <%= oh.instructor %></p>
            <p><strong>Day:</strong> <%= oh.day %></p>
            <p><strong>Time:</strong> <%= oh.start_time %> - <%= oh.end_time %></p>
            <p><strong>Location:</strong> <%= oh.location %></p>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <p class="ol-muted">No office hours available right now.</p>
    <% end %>
  </div>
<% end %>
