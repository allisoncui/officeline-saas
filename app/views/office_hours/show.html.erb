<!-- Back Link -->
<div style="margin-bottom: 16px; text-align: right;">
  <%= link_to "Back to Office Hours",
      office_hours_path,
      class: "ol-link",
      style: "color: #2563eb; text-decoration: none; font-weight: 500;" %>
</div>

<!-- Office Hour Details -->
<div class="office-hour-details ol-card"
     style="background: #f0f8ff; padding: 16px; border-radius: 10px;">
  <p><strong>Course:</strong> <%= @office_hour.course_name %></p>
  <p><strong>Instructor:</strong> <%= @office_hour.instructor %></p>
  <p><strong>Day:</strong> <%= @office_hour.day %></p>
  <p><strong>Time:</strong> <%= @office_hour.start_time %> - <%= @office_hour.end_time %></p>
  <p><strong>Location:</strong> <%= @office_hour.location %></p>
</div>

<!-- TA Actions -->
<% if current_user&.ta? && @office_hour.ta_uni == current_user.uni %>
  <div class="ol-actions-bar" style="margin-top: 16px; display: flex; align-items: center; gap: 10px;">
    <%= link_to "Edit Office Hour",
        edit_office_hour_path(@office_hour),
        class: "ol-btn",
        style: "background: #2563eb; color: white; border-radius: 6px; padding: 8px 14px; text-decoration: none; transition: background 0.2s ease;" %>

    <%= button_to "Delete",
        @office_hour,
        method: :delete,
        form: { class: "ol-inline-form" },
        class: "ol-btn",
        style: "background: #ef4444; color: white; border-radius: 6px; padding: 8px 14px; border: none; cursor: pointer; transition: background 0.2s ease;",
        data: { confirm: 'Are you sure you want to delete this office hour?' } %>
  </div>
<% end %>

<!-- Queue Section -->
<div class="ol-card" style="margin-top: 24px; padding: 16px; border-radius: 10px; background: #fef3c7;">
  <h3 class="ol-section-title">Office Hour Queue</h3>
  
  <%= render 'queue_section', office_hour: @office_hour %>
</div>

<!-- Auto-update script -->
<script>
  <% if @office_hour.queue_active? || current_user&.ta? %>
    // Auto-update queue every 3 seconds
    const updateInterval = setInterval(function() {
      fetch('<%= queue_status_office_hour_path(@office_hour) %>', {
        headers: {
          'Accept': 'text/html',
          'X-Requested-With': 'XMLHttpRequest'
        }
      })
      .then(response => {
        if (!response.ok) throw new Error('Network response was not ok');
        return response.text();
      })
      .then(html => {
        const queueContent = document.getElementById('queue-content');
        if (queueContent) {
          queueContent.innerHTML = html;
        }
      })
      .catch(error => {
        console.error('Error updating queue:', error);
      });
    }, 3000);

    // Stop polling when user leaves the page
    window.addEventListener('beforeunload', function() {
      clearInterval(updateInterval);
    });
  <% end %>
</script>

<!-- Conditional Content for Students or TAs -->
<% if current_user&.student? %>
  <!-- STUDENT VIEW: Submit Question -->
  <div class="ol-card question-form" style="margin-top: 24px;">
    <h3 class="ol-section-title">Submit a Question</h3>
    <%= form_with model: [@office_hour, Question.new], local: true do |form| %>
      <div class="ol-field">
        <%= form.label :question_type, "Question Type:", class: "ol-label" %>
        <%= form.select :question_type,
            options_for_select(Question::QUESTION_TYPES, form.object.question_type),
            { prompt: 'Select a question type' },
            { class: "ol-select", required: true } %>
      </div>
      <div class="ol-field">
        <%= form.label :question_text, "Your Question/Topic:", class: "ol-label" %>
        <%= form.text_area :question_text, rows: 3,
            placeholder: "What would you like help with?",
            class: "ol-textarea" %>
      </div>
      <div class="ol-actions ol-right">
        <%= form.submit "Submit Question",
            class: "ol-btn",
            style: "background: #2563eb; color: white; border-radius: 6px; padding: 8px 14px;" %>
      </div>
    <% end %>
  </div>

  <!-- Previous Questions -->
  <h3 class="ol-section-title" style="margin-top: 24px;">Previous Questions</h3>
  <div class="ol-card" style="padding: 16px; border-radius: 10px; background: #fafafa;">
    <% if @office_hour.questions.any? %>
      <% @office_hour.questions.order(created_at: :desc).each do |question| %>
        <div class="question-item" style="margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid #eee;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px;">
            <div style="flex: 1;">
              <div style="margin-bottom: 4px;">
                <span style="background: #dbeafe; color: #1d4ed8; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">
                  <%= question.question_type_display %>
                </span>
              </div>
              <div><strong>Question:</strong> <%= question.question_text %></div>
              <div style="font-size: 0.9em; color: gray;">
                Submitted: <%= question.created_at.strftime("%B %d, %Y at %I:%M %p") %>
              </div>
            </div>
            <% if question.user == current_user %>
              <div style="display: flex; gap: 8px; flex-shrink: 0;">
                <%= link_to 'Edit', edit_office_hour_question_path(@office_hour, question),
                            class: 'ol-btn ol-btn-outline',
                            style: 'padding: 4px 10px; font-size: 0.85rem;' %>
                <%= button_to 'Delete', office_hour_question_path(@office_hour, question),
                             method: :delete,
                             class: 'ol-btn ol-btn-danger',
                             style: 'padding: 4px 10px; font-size: 0.85rem;',
                             data: { confirm: 'Are you sure you want to delete this question?', turbo: false } %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p><em>No questions submitted yet. Be the first to ask!</em></p>
    <% end %>
  </div>

<% elsif current_user&.ta? %>
  <!-- TA VIEW: Question Summary -->
  <div class="ol-card" style="margin-top: 24px; padding: 16px; border-radius: 10px; background: #fafafa;">
    <h3 class="ol-section-title" style="margin-bottom: 12px;">Questions Summary</h3>
    
    <% if @office_hour.queue_active? %>
      <% current_session = @office_hour.queue_sessions.find_by(ended_at: nil) %>
      <% if current_session && current_session.questions.any? %>
        <div style="margin-bottom: 16px;">
          <h4 style="margin: 0 0 8px 0; font-size: 1rem; color: #059669;">
            Current Session (<%= current_session.started_at.strftime("%I:%M %p") %>)
          </h4>
          <ul style="list-style: none; padding: 0; margin: 0;">
            <% current_session.questions.order(created_at: :desc).each do |question| %>
              <li style="margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid #eee;">
                <div style="margin-bottom: 4px;">
                  <span style="background: #dbeafe; color: #1d4ed8; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">
                    <%= question.question_type_display %>
                  </span>
                </div>
                <div><strong><%= question.user.uni %>:</strong> <%= question.question_text %></div>
                <div style="font-size: 0.9em; color: gray;">
                  Submitted <%= time_ago_in_words(question.created_at) %> ago
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>
    
    <% # Show questions not associated with any session (submitted before queue started) %>
    <% unassociated_questions = @office_hour.questions.where(queue_session_id: nil) %>
    <% if unassociated_questions.any? %>
      <div style="margin-top: 16px; padding-top: 16px; border-top: 2px solid #e5e7eb;">
        <h4 style="margin: 0 0 8px 0; font-size: 1rem; color: #6b7280;">
          Questions Submitted Before Queue Started
        </h4>
        <ul style="list-style: none; padding: 0; margin: 0;">
          <% unassociated_questions.order(created_at: :desc).each do |question| %>
            <li style="margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid #eee;">
              <div style="margin-bottom: 4px;">
                <span style="background: #dbeafe; color: #1d4ed8; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">
                  <%= question.question_type_display %>
                </span>
              </div>
              <div><strong><%= question.user.uni %>:</strong> <%= question.question_text %></div>
              <div style="font-size: 0.9em; color: gray;">
                Submitted <%= time_ago_in_words(question.created_at) %> ago
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
    
    <% if @office_hour.questions.empty? %>
      <p><em>No questions have been submitted yet.</em></p>
    <% elsif @office_hour.queue_active? && (!current_session || current_session.questions.empty?) && unassociated_questions.empty? %>
      <p><em>No questions for the current session yet.</em></p>
    <% end %>
  </div>
<% end %>