<!DOCTYPE html>
<html>
  <head>
    <title>OfficeLine</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="ol-topbar">
      <div class="ol-wrap ol-header">
        <%= link_to "OfficeLine", office_hours_path, class: "ol-brand" %>
        <div class="ol-user-menu">
          <% if user_signed_in? %>
            <span class="ol-user-info">
              <%= current_user.uni %> (<%= current_user.role.upcase %>)
              
              <% if current_user.other_account %>
                | <%= button_to "Switch to #{current_user.other_account.role.capitalize}", 
                                destroy_user_session_path(switch_to: current_user.other_account.role), 
                                method: :delete,
                                data: { turbo: false },
                                style: "display: inline; background: none; border: none; color: #2563eb; text-decoration: none; font-weight: 500; cursor: pointer; padding: 0; font-size: inherit;" %>
              <% end %>
            </span>
            <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "ol-btn ol-btn-logout" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "ol-link" %>
            <%= link_to "Sign up", new_user_registration_path, data: { testid: "signup-link" } %>
          <% end %>
        </div>
      </div>
    </header>

    <main class="ol-wrap">
      <% flash.each do |type, msg| %>
        <div class="ol-flash <%= type %>"><%= msg %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
