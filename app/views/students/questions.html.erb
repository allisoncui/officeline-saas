<!-- Tabs -->
<div class="ol-tabs" style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
  <%= link_to "Home",
      office_hours_path,
      class: "ol-tab-btn",
      style: "
        padding: 8px 16px;
        border-radius: 8px;
        border: 1px solid #2563eb;
        font-weight: 500;
        text-decoration: none;
        color: #2563eb;
        background: white;
        transition: all 0.2s ease;
      ",
      onmouseover: "this.style.background='#eff6ff'",
      onmouseout: "this.style.background='white'" %>

  <%= link_to "My Classes",
      student_profile_path,
      class: "ol-tab-btn",
      style: "
        padding: 8px 16px;
        border-radius: 8px;
        border: 1px solid #2563eb;
        font-weight: 500;
        text-decoration: none;
        color: #2563eb;
        background: white;
        transition: all 0.2s ease;
      ",
      onmouseover: "this.style.background='#eff6ff'",
      onmouseout: "this.style.background='white'" %>

  <%= link_to "My Hours",
      student_my_hours_path,
      class: "ol-tab-btn",
      style: "
        padding: 8px 16px;
        border-radius: 8px;
        border: 1px solid #2563eb;
        font-weight: 500;
        text-decoration: none;
        color: #2563eb;
        background: white;
        transition: all 0.2s ease;
      ",
      onmouseover: "this.style.background='#eff6ff'",
      onmouseout: "this.style.background='white'" %>

  <%= link_to "My Questions",
      student_questions_path,
      class: "ol-tab-btn active",
      style: "
        padding: 8px 16px;
        border-radius: 8px;
        border: 1px solid #2563eb;
        font-weight: 500;
        text-decoration: none;
        color: white;
        background: #2563eb;
        transition: all 0.2s ease;
      ",
      onmouseover: "this.style.background='#1d4ed8'",
      onmouseout: "this.style.background='#2563eb'" %>
</div>

<h1 class="ol-title">My Submitted Questions</h1>

<% if @my_questions.any? %>
  <p id="results-summary" class="ol-muted" style="margin-bottom: 16px;">
    <%= pluralize(current_user.questions.count, "question") %> across <%= pluralize(@my_questions.keys.count, "class") %>
  </p>
  
  <% @my_questions.each do |office_hour, questions| %>
    <div class="ol-card" style="margin-bottom: 24px;">
      <div style="margin-bottom: 16px; padding-bottom: 12px; border-bottom: 2px solid #e5e7eb;">
        <h3 style="margin: 0 0 4px 0; font-size: 1.1rem; font-weight: 700;">
          <%= link_to office_hour.course_name, office_hour_path(office_hour), style: "color: #2563eb; text-decoration: none;" %>
        </h3>
        <p style="margin: 0; color: #64748b; font-size: 0.9rem;">
          <%= office_hour.instructor %> • <%= office_hour.day %> <%= office_hour.start_time %> - <%= office_hour.end_time %>
        </p>
      </div>
      
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <% questions.each do |question| %>
          <div class="question-item" style="position: relative;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px;">
              <div style="flex: 1;">
                <p style="margin: 0 0 8px 0; color: #0f172a;"><%= question.question_text %></p>
                <p style="margin: 0; color: #94a3b8; font-size: 0.85rem;">
                  Submitted <%= time_ago_in_words(question.created_at) %> ago
                </p>
              </div>
              <div style="display: flex; gap: 8px; flex-shrink: 0;">
                <%= link_to 'Edit', edit_office_hour_question_path(office_hour, question),
                            class: 'ol-btn ol-btn-outline',
                            style: 'padding: 4px 10px; font-size: 0.85rem;' %>
                <%= button_to 'Delete', office_hour_question_path(office_hour, question),
                             method: :delete,
                             class: 'ol-btn ol-btn-danger',
                             style: 'padding: 4px 10px; font-size: 0.85rem;',
                             data: { confirm: 'Are you sure you want to delete this question?', turbo: false } %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="ol-card">
    <p style="margin: 0; color: #64748b;">
      You haven't submitted any questions yet. Visit an office hour page to ask a question!
    </p>
  </div>
<% end %>
